  "preDialog": [
    {
      "speaker": "旁白",
      "text": "巨籁达路的旧书店比霞飞路那家更小，门脸漆面剥落了大半。沈墨推门进去时，门铃没有响——铃铛被人摘掉了，只剩一根空绳。",
      "isNarration": true
    },
    {
      "speaker": "旁白",
      "text": "店内空无一人。但正对门的书桌上，放着一本翻开的旧书——翻到的那一页，是一道数独题。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……题面旁边有一行铅笔字。是他写的。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "行区块排除——当一个数字在某个宫里只能出现在同一行时，整行其他位置都不能再放它。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨解完题，在题面右下角看到一行字，字迹是父亲的：“你找到这里了。但路还没有走完。”",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……他来过这里。他走之前在每一个节点都留下了路标。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "你父亲留下的，不是答案——是线索。每一条线索都指向下一个位置。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
