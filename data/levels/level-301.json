  "triggers": [
    {
      "id": "t301_multirow",
      "condition": "onLevelStart",
      "type": "popup_hint",
      "text": "试试把两行加起来看？21×2=42，有时候能发现突破口！",
      "once": true
    },
    {
      "id": "t301_f1",
      "condition": "onFirstNumberFilled",
      "type": "popup_hint",
      "position": "top",
      "text": "对了！这就是区块排除——当数字在这个宫里只能出现在这一行时，整行其他位置都排除掉！",
      "once": true
    },
    {
      "id": "t301_b",
      "condition": "onFillCountReached",
      "count": 59,
      "type": "enter_phase",
      "phase": "breakthrough",
      "once": true
    },
    {
      "id": "t301_bt",
      "condition": "onFillCountReached",
      "count": 59,
      "type": "popup_hint",
      "position": "top",
      "text": "⚡ 破局时刻！你找到了关键的行区块排除，连锁反应开始了！",
      "once": true,
      "delay": 400
    },
    {
      "id": "t301_st20",
      "condition": "onStuckForSeconds",
      "seconds": 20,
      "type": "popup_hint",
      "position": "top",
      "text": "💡 卡住了？找一个数字，看它在某个3×3宫里的可能位置——如果这些位置恰好在同一行，那整行其他位置都排除掉！",
      "once": false
    },
    {
      "id": "t301_st40",
      "condition": "onStuckForSeconds",
      "seconds": 40,
      "type": "popup_hint",
      "position": "top",
      "text": "💡 行区块口诀：「宫看行，行删余」。打开笔记笔记（✏️），标记所有候选，区块就会自己跳出来！",
      "once": false,
      "delay": 300
    },
    {
      "id": "t301_ag",
      "condition": "onConflict",
      "type": "popup_hint",
      "position": "top",
      "text": "⚠️ 猜数字是行不通的！找到区块证据再填——如果笔记没标记，先标上！",
      "once": false
    },
    {
