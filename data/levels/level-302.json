  "preDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨在路路通茶馆二楼的桌面上发现了一本旧棋谱。翻开时，里面夹着一张纸条。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……棋谱的边角有一道折痕。纸是旧的，但折痕是新的——有人最近才翻过它。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "路路通茶馆是另一条路。你父亲走的路，和你老师铺的路，在某一处是重叠的。你需要在重叠的位置落脚。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "列区块排除——当一个数字在某个宫里只能出现在同一列时，整列其他位置都不能再放它。方向变了，但方法一样。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨解完题，发现棋盘底部有一行字，比父亲的笔迹更淡：“山重水复疑无路。”",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……不是他写的。是另一个人的手笔。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "那是你父亲认识的人。他在特高课里。但他和你父亲，曾经坐在同一张桌子前解过同一道题。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
