      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "你母亲等的人，是你父亲。他来了，但他没有走进那扇门。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
