  "preDialog": [
    {
      "speaker": "旁白",
      "text": "B1走廊两侧的石壁上，密密麻麻刻满了数字。沈墨放慢脚步，一行一行看过去。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……有些刻痕很旧，有些还带着新磨出的棱角。不同年代的人走过同一条走廊，留下了同一种记号。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "隐性唯一——不是看格子有多少可能，是看一个数字在整个区域内只剩一条路。它在别的行里已经出现了，别的列里也已经出现了。剩下的那个位置，就是它唯一能站的地方。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨在第七组刻痕前停住。那组数字的最后三位，和他父亲笔记里的一模一样。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……他来过这里。他走这条路的时候，在这面墙上留下了记号。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "你父亲留下的不止是路标。他留下的是一种选择——他在这里停下来，等你走到同一个位置。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
