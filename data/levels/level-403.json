  "preDialog": [
    {
      "speaker": "旁白",
      "text": "B2密室比沈墨预想的大。中央一张木桌，角落堆着几只旧木箱。他走近时，看到桌面上放着一本打开的练习册。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……封面是空白的。但扉页上有一个名字。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "那本练习册是伊藤留下的。他把自己的痕迹留在这里——不是为了让你找到他，是为了让你知道，他先于你走过这条路。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "数对占位——两个数字被锁在同一对格子里。你不需要马上知道哪个填哪格，你只需要知道，它们只能出现在这两个位置，其他地方都不能再出现它们。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨合上练习册。桌面上有一道被压过的痕迹——有人曾在这里坐了很久。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……伊藤来过这里。他留下练习册，是让我知道——在我之前已经有另一个人走完了这条路的一半。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "他没有拿走练习册，也没有销毁它。他把练习册放在桌面上——那是一份他留给下一个人的记录。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
