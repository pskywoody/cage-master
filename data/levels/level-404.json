  "preDialog": [
    {
      "speaker": "旁白",
      "text": "木桌的抽屉里放着一沓纸，每一张都是一道数独题。一共七道——从简单到复杂，依次排列。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……是她留的。她离开之前把这些题放在了这里。她知道冬天会有人来解。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "三子法——当三个格子合起来只包含三个不同的数字时，这三个数字就被锁死了。它们不能出现在这三格之外的任何位置。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨解完了第一道题。纸张底部有一行字：“还有六道。不用急——你需要时间。”",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……她在告诉我，这是一次流程，不是一场考试。她给了足够的时间让我走完。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "七道题，每一道都对应一段路。你走得越深，最后的那一道就越接近终点。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
