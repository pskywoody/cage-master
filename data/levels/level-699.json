  "preDialog": [
    {
      "speaker": "阿妍",
      "text": "……你早就知道信不是他写的？",
      "_action": "看着沈墨，眼神里有很多没有说出口的话",
      "vo": "VO_R_0071",
      "emotion": "低沉·询问"
    },
    {
      "speaker": "沈墨",
      "text": "我不知道。但我需要确认。",
      "_action": "把信放回口袋",
      "vo": "VO_SM_0070",
      "emotion": "平静"
    },
    {
      "speaker": "守笼人",
      "text": "这是守笼人的钥匙。如果你选择留下……",
      "_action": "走到沈墨面前，把一把古旧的钥匙递给他",
      "vo": "VO_CK_0093",
      "emotion": "庄重·托付"
    },
    {
      "speaker": "沈墨",
      "text": "……我还没做出选择。",
      "_action": "看着钥匙，没有接",
      "vo": "VO_SM_0071",
      "emotion": "平静"
    },
    {
      "speaker": "守笼人",
      "text": "没关系。第七层有你要找的答案。",
      "_action": "微笑",
      "vo": "VO_CK_0094",
      "emotion": "温和·释然"
    },
    {
      "speaker": "阿妍",
      "text": "……不管你选什么，我都在。",
      "_action": "走到沈墨身边，轻声",
      "vo": "VO_R_0072",
      "emotion": "极轻·坚定"
    },
    {
      "speaker": "沈墨",
      "text": "我不是来解开这一局的。我是来找到你的。",
      "pause": 1,
      "vo": "VO_SM_0072",
      "emotion": "核心·坚定·比第一章更沉"
    }
  ],
  "clearDialog": [
    {
      "speaker": "守笼人",
      "text": "终局已破。第七卷秘术档案，是设局人留下的最后一件东西。",
