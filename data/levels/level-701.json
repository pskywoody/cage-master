  "preDialog": [
    {
      "speaker": "旁白",
      "text": "珍珠港的消息传遍整座城市。沈墨坐在帐房里，没有点灯。街面上有兵车开过的声音，比往常更重、更急。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……我发了。但发完的时候，一切都已经被决定了。电文能改变什么吗？",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "并蒂锁深化——两个数字被锁在同一对格子里。你之前只是识别它们，现在你要确认它们仍然在原位。档案也是一样——确认它没有被动过。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨翻开帐本。夹层里的那张纸还在原位——没有被翻动过，没有被取走。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……档案还在。他没有动过它。或者说，他动过，但把它放回了原处。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "帐房里的档案是整条链路的最后一处副本。只要它还在，那条路的痕迹就没有被完全抹掉。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
