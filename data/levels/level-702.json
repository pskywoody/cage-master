  "preDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨在清晨走到霞飞路。书店的门锁着，门缝里没有光。窗台上放着一本书——书脊朝外，和六月他第一次来的时候一模一样。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……书还在。但她已经不在了。她把书留在这里，是为了让我知道——题面已经销毁了。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "老师（留声）",
      "text": "隐曜深化——当一个数字在行、列、宫中只剩一个位置时，它就是答案。在整条链路中，当所有痕迹都被清理之后，剩下的那个痕迹就是最关键的。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
  "clearDialog": [
    {
      "speaker": "旁白",
      "text": "沈墨翻开窗台上那本书。书页之间夹着一条纸条：“你走的路是对的。”没有署名。",
      "isNarration": true
    },
    {
      "speaker": "沈墨 CHIBI",
      "text": "……是她放的。她不在上海了，但她在离开之前把这句话留在了这里。",
      "side": "left",
      "emotion": "thinking",
      "effect": 0
    },
    {
      "speaker": "薇拉",
      "text": "她留下的那条纸条，是你最后一次确认链路安全的凭证。她会确保那条路在关闭时不会留下任何可被追踪的痕迹。",
      "side": "right",
      "emotion": "calm",
      "effect": 0
    }
  ],
