  "triggers": [
    {
      "condition": "onLevelStart",
      "type": "freeze_mask",
      "highlight": "full",
      "text": "提示：二连纵横阵不会立刻显现——它需要候选数收敛后才成形。先用你掌握的排除法推进盘面，当某个数字在行/列中的位置开始收窄，矩形的四个角就会出现！",
      "once": true,
